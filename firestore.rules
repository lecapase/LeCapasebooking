rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================
    // ACCESSO E RUOLI
    // =====================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function legacyAdminExists() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        ).data.active == true
        && get(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        ).data.role == 'admin';
    }

    function staffProfileExists() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/staff_users/$(request.auth.uid)
        );
    }

    function staffProfile() {
      return get(
        /databases/$(database)/documents/staff_users/$(request.auth.uid)
      ).data;
    }

    function isActiveStaff() {
      return staffProfileExists()
        && staffProfile().active == true;
    }

    function hasRole(roleName) {
      return isActiveStaff()
        && staffProfile().role == roleName;
    }

    function isAdmin() {
      return legacyAdminExists()
        || hasRole('admin');
    }

    function isManager() {
      return isAdmin()
        || hasRole('manager');
    }

    function isSupervisor() {
      return isManager()
        || hasRole('supervisor');
    }

    function canViewBookings() {
      return isSupervisor()
        || hasRole('staff');
    }

    function isOnlySupervisor() {
      return hasRole('supervisor');
    }

    // =====================================================
    // BLOCCO DELLE GIORNATE PASSATE
    // =====================================================

    function currentBusinessDateKey() {
      return get(
        /databases/$(database)/documents/_system/current_business_date
      ).data.dateKey;
    }

    function isCurrentOrFutureBooking(bookingData) {
      return bookingData.dateKey == currentBusinessDateKey()
        || (
          bookingData.date is timestamp
          && bookingData.date > request.time
        );
    }

    function bookingDateIsUnchanged() {
      return request.resource.data.dateKey == resource.data.dateKey
        && request.resource.data.date == resource.data.date;
    }

    // =====================================================
    // AGGIORNAMENTI CONSENTITI AL SUPERVISOR
    // =====================================================

    function validManagerNotificationReadUpdate() {
      let changedKeys = request.resource.data
        .diff(resource.data)
        .affectedKeys();

      return isManager()

        && changedKeys.hasOnly([
          'adminNotificationRead',
          'adminNotificationReadAt',
          'reconfirmationResultRead',
          'reconfirmationResultReadAt',
          'updatedAt'
        ])

        && request.resource.data.adminNotificationRead == true

        && request.resource.data.adminNotificationReadAt
          == request.time

        && request.resource.data.updatedAt
          == request.time

        && (
          !changedKeys.hasAny([
            'reconfirmationResultRead',
            'reconfirmationResultReadAt'
          ])
          || (
            request.resource.data.reconfirmationResultRead == true
            && request.resource.data.reconfirmationResultReadAt
              == request.time
          )
        );
    }

    // Historical corrections are restricted to operational status and its audit fields.
    function validHistoricalStatusUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let status = request.resource.data.status;
      return isManager()
        && resource.data.dateKey < currentBusinessDateKey()
        && resource.data.date is timestamp
        && resource.data.date < request.time
        && request.resource.data.updatedAt == request.time
        && (
          (status == 'arrived'
            && changed.hasOnly(['status', 'updatedAt', 'arrivedAt', 'arrivedBy'])
            && request.resource.data.arrivedAt == request.time
            && request.resource.data.arrivedBy == 'admin')
          || (status == 'released'
            && changed.hasOnly(['status', 'updatedAt', 'releasedAt', 'releasedBy'])
            && request.resource.data.releasedAt == request.time
            && request.resource.data.releasedBy == 'admin')
          || (status == 'no_show'
            && changed.hasOnly(['status', 'updatedAt', 'noShowAt', 'noShowBy'])
            && request.resource.data.noShowAt == request.time
            && request.resource.data.noShowBy == 'admin')
        );
    }

    function validSupervisorBookingUpdate() {
      return isOnlySupervisor()

        && resource.data.status == 'pending'

        && (
          request.resource.data.status == 'confirmed'
          || request.resource.data.status == 'cancelled'
          || request.resource.data.status == 'rejected'
        )

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'previousStatus',
            'updatedAt',
            'statusChangedAt',
            'statusChangedBy',
            'requiresManualConfirmation',
            'confirmedAt',
            'confirmedBy',
            'cancelledAt',
            'cancelledBy',
            'rejectedAt',
            'rejectedBy'
          ]);
    }

    function validSupervisorCounterUpdate() {
      return isOnlySupervisor()

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'bookedGuests',
            'updatedAt'
          ])

        && request.resource.data.bookedGuests is int
        && request.resource.data.bookedGuests >= 0
        && request.resource.data.bookedGuests <= 1000;
    }

    // =====================================================
    // VALIDAZIONE PRENOTAZIONE CLIENTE
    // =====================================================

    function notesContainHealthData(notes) {
      return notes.matches(
        '(?i).*(allerg|intoller|celiach|glutine|gluten|lattos|lactos|diabet|anafil|farmac|patolog|malatt|salute|sanitari|health|medical|medication|disease).*'
      );
    }

    function isValidCustomerBooking() {
      let data = request.resource.data;
      return data.keys().size() == 61

      && data.nome is string
      && data.nome.size() >= 1
      && data.nome.size() <= 100

      && data.cognome is string
      && data.cognome.size() >= 1
      && data.cognome.size() <= 100

      && data.email is string
      && data.email.size() >= 5
      && data.email.size() <= 254

      && data.normalizedEmail is string
      && data.normalizedEmail.size() >= 5
      && data.normalizedEmail.size() <= 254

      && data.telefono is string
      && data.telefono.size() >= 5
      && data.telefono.size() <= 30

      && data.normalizedPhone is string
      && data.normalizedPhone.size() >= 5
      && data.normalizedPhone.size() <= 30

      && data.customerKey is string
      && data.customerKey.size() >= 1
      && data.customerKey.size() <= 300

      && data.date is timestamp

      && data.dateKey is string
      && data.dateKey.size() == 10

      && data.weekday is int
      && data.weekday >= 1
      && data.weekday <= 7

      && data.time is string
      && data.time.matches(
        '^[0-2][0-9]:[0-5][0-9]$'
      )

      && data['service'] is string
      && (
        data['service'] == 'lunch'
        || data['service'] == 'dinner'
      )

      && data.guests is int
      && data.guests >= 1
      && data.guests <= 20

      && data.occasion is string
      && data.occasion.size() <= 200

      && data.occasionCode is string
      && (
        data.occasionCode == 'none'
        || data.occasionCode == 'birthday'
        || data.occasionCode == 'anniversary'
        || data.occasionCode == 'romantic_dinner'
        || data.occasionCode == 'business_event'
      )

      && data.language is string
      && (
        data.language == 'it'
        || data.language == 'en'
      )

      && data.notes is string
      && data.notes.size() <= 500

      && data.healthDataDetected is bool
      && data.healthDataDetected
        == notesContainHealthData(data.notes)
      && data.healthDataConsent is bool
      && data.healthDataConsentVersion == '1.0'
      && data.healthDataConsentLanguage
        == data.language
      && data.notesPurgedAt == null
      && (
        (
          data.healthDataDetected == true
          && data.healthDataConsent == true
          && data.healthDataConsentRecordedAt is timestamp
        )
        || (
          data.healthDataDetected == false
          && data.healthDataConsent == false
          && data.healthDataConsentRecordedAt == null
        )
      )

      && data.source == 'customer'

      && data.bookingOrigin is string
      && (
        data.bookingOrigin == 'google'
        || data.bookingOrigin == 'instagram'
        || data.bookingOrigin == 'whatsapp'
        || data.bookingOrigin == 'direct'
      )

      && data.privacyNoticeAccepted == true
      && data.privacyNoticeVersion == '1.0'
      && data.privacyNoticeLanguage
        == data.language
      && data.privacyNoticeAcceptedAt is timestamp

      && data.bookingWhatsappConsent == true
      && data.bookingWhatsappConsentVersion == '1.0'
      && data.bookingWhatsappConsentSource
        == 'customer_booking_submit'
      && data.bookingWhatsappConsentRecordedAt is timestamp

      && data.marketingEmailConsent is bool
      && data.marketingWhatsappConsent is bool
      && (data.marketingConsentVersion == '2.0'
        || (data.marketingConsentVersion == '1.0'
          && data.marketingEmailConsent
            == data.marketingWhatsappConsent))
      && data.marketingConsentSource == 'customer_booking'
      && data.marketingConsentRecordedAt is timestamp
      && (data.marketingConsentVersion == '1.0'
        || data.marketingConsentRecordedAt == request.time)

      && data.createdAt is timestamp
      && data.updatedAt is timestamp

      && (
        (
          data.guests <= 4
          && data.bookedAt is timestamp
          && data.bookedBy == 'automatic'
        )
        || (
          data.guests >= 5
          && data.bookedAt == null
          && data.bookedBy == null
        )
      )

      && data.confirmedAt == null
      && data.confirmedBy == null
      && data.cancelledAt == null
      && data.cancelledBy == null
      && data.noShowAt == null
      && data.noShowBy == null
      && data.noShowRecorded == false

      && data.requestReceivedEmailSent == false
      && data.confirmationEmailSent == false
      && data.cancellationEmailSent == false
      && data.rejectionEmailSent == false

      && data.confirmationWhatsappSent == false
      && data.cancellationWhatsappSent == false
      && data.rejectionWhatsappSent == false

      && data.adminNotificationSent == false

      && (
        (
          data.guests <= 4
          && data.status == 'booked'
          && data.autoBooked == true
          && data.autoConfirmed == true
          && data.requiresManualConfirmation == false
        )
        ||
        (
          data.guests >= 5
          && data.status == 'pending'
          && data.autoBooked == false
          && data.autoConfirmed == false
          && data.requiresManualConfirmation == true
        )
      );
    }

    // =====================================================
    // CONTROLLO CONTATORE NUOVO DEL CLIENTE
    // =====================================================

    function validNewCounter() {
      let bookingId = request.resource.data.lastBookingId;
      let bookingPath =
        /databases/$(database)/documents/bookings/$(bookingId);

      return request.resource.data.keys().hasAll([
          'dateKey',
          'weekday',
          'service',
          'bookedGuests',
          'lastBookingId',
          'updatedAt'
        ])

        && request.resource.data.dateKey is string
        && request.resource.data.weekday is int
        && request.resource.data['service'] is string
        && request.resource.data.bookedGuests is int
        && request.resource.data.bookedGuests >= 1
        && request.resource.data.bookedGuests <= 1000
        && request.resource.data.lastBookingId is string

        && existsAfter(bookingPath)

        && getAfter(bookingPath).data.source == 'customer'
        && getAfter(bookingPath).data.dateKey
          == request.resource.data.dateKey
        && getAfter(bookingPath).data.weekday
          == request.resource.data.weekday
        && getAfter(bookingPath).data['service']
          == request.resource.data['service']
        && getAfter(bookingPath).data.guests
          == request.resource.data.bookedGuests;
    }

    // =====================================================
    // CONTROLLO AGGIORNAMENTO CONTATORE DEL CLIENTE
    // =====================================================

    function validUpdatedCounter() {
      let bookingId = request.resource.data.lastBookingId;
      let bookingPath =
        /databases/$(database)/documents/bookings/$(bookingId);

      return request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly([
          'bookedGuests',
          'lastBookingId',
          'updatedAt'
        ])

        && request.resource.data.dateKey
          == resource.data.dateKey
        && request.resource.data.weekday
          == resource.data.weekday
        && request.resource.data['service']
          == resource.data['service']

        && request.resource.data.bookedGuests is int
        && request.resource.data.bookedGuests >= 1
        && request.resource.data.bookedGuests <= 1000

        && request.resource.data.lastBookingId is string

        && existsAfter(bookingPath)

        && getAfter(bookingPath).data.source == 'customer'
        && getAfter(bookingPath).data.dateKey
          == request.resource.data.dateKey
        && getAfter(bookingPath).data.weekday
          == request.resource.data.weekday
        && getAfter(bookingPath).data['service']
          == request.resource.data['service']

        && request.resource.data.bookedGuests
          == resource.data.bookedGuests
            + getAfter(bookingPath).data.guests;
    }

    // =====================================================
    // DISPONIBILITÃƒâ‚¬ E SERVIZI
    // =====================================================

    match /availability_weekly/{documentId} {
      allow read: if true;
      allow write: if isManager();
    }

    match /availability_exceptions/{documentId} {
      allow read: if true;
      allow write: if isManager();
    }

    match /managed_services/{documentId} {
      allow read: if true;
      allow write: if isManager();
    }

    // =====================================================
    // PRENOTAZIONI
    // =====================================================

    match /booking_slot_closures/{documentId} {
      allow read: if true;

      allow create, update: if isManager()
        && request.resource.data.keys().hasOnly([
          'dateKey',
          'service',
          'time',
          'closed',
          'updatedAt'
        ])
        && request.resource.data.dateKey is string
        && request.resource.data.dateKey.size() == 10
        && (
          request.resource.data['service'] == 'lunch'
          || request.resource.data['service'] == 'dinner'
        )
        && request.resource.data.time is string
        && request.resource.data.time.size() == 5
        && request.resource.data.closed == true

      allow delete: if isManager();
    }

    match /booking_service_closures/{documentId} {
      allow read: if true;

      allow create, update: if isManager()
        && request.resource.data.keys().hasOnly([
          'dateKey',
          'service',
          'mode',
          'closed',
          'reason',
          'closedBy',
          'cancelledBookings',
          'updatedAt'
        ])
        && request.resource.data.dateKey is string
        && request.resource.data.dateKey.size() == 10
        && (
          request.resource.data['service'] == 'lunch'
          || request.resource.data['service'] == 'dinner'
        )
        && (
          request.resource.data.mode == 'online_disabled'
          || request.resource.data.mode == 'service_closed'
        )
        && request.resource.data.closed == true;

      allow delete: if isManager();
    }

    match /bookings/{bookingId} {
      allow create: if isCurrentOrFutureBooking(request.resource.data)
        && (
          isManager()
          || (
            isValidCustomerBooking()
            && !exists(
              /databases/$(database)/documents/booking_slot_closures/$(request.resource.data.dateKey + "_" + request.resource.data['service'] + "_" + request.resource.data.time)
            )
            && !exists(
              /databases/$(database)/documents/booking_service_closures/$(request.resource.data.dateKey + "_" + request.resource.data['service'])
            )
          )
        );

      allow read: if canViewBookings();

      allow update: if validManagerNotificationReadUpdate()
        || validHistoricalStatusUpdate()
        || (
          isCurrentOrFutureBooking(resource.data)
          && bookingDateIsUnchanged()
          && (
            isManager()
            || validSupervisorBookingUpdate()
          )
        );

      allow delete: if isAdmin()
        && isCurrentOrFutureBooking(resource.data);
    }

    // =====================================================
    // CONTATORI DEI COPERTI
    // =====================================================

    match /availability_counters/{counterId} {
      allow read: if true;

      allow create: if isManager()
        || validNewCounter();

      allow update: if isManager()
        || validSupervisorCounterUpdate()
        || validUpdatedCounter();

      allow delete: if isAdmin();
    }

    // =====================================================
    // ARCHIVIO CLIENTI
    // =====================================================

    match /customers/{customerId} {
      allow read, write: if isManager();
    }

    match /customer_profiles/{customerId} {
      allow read: if isAdmin();
      // Consent changes and their audit trail are written by trusted Functions.
      allow write: if false;
    }

    // =====================================================
    // MARKETING ED EVENTI EMAIL
    // =====================================================

    match /marketing_contacts/{contactId} {
      allow read, write: if isAdmin();
    }

    match /email_events/{eventId} {
      allow read, write: if isAdmin();
    }

    match /_system_email_events/{eventId} {
      allow read, write: if isAdmin();
    }

    // =====================================================
    // PROFILI DELLO STAFF
    // =====================================================

    match /staff_users/{staffId} {
      allow read: if isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == staffId
        );

      allow create, update, delete: if isAdmin();
    }

    // =====================================================
    // INVITI PER NUOVI UTENTI
    // =====================================================

    match /staff_user_invites/{inviteId} {
      allow read, create, update, delete: if isAdmin();
    }

    // =====================================================
    // AMMINISTRATORI PREESISTENTI
    // =====================================================

    // =====================================================
    // DISPOSITIVI PER NOTIFICHE PUSH
    // =====================================================

    match /notification_devices/{userId} {
      allow read: if isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == userId
          && canViewBookings()
        );

      allow create, update: if isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == userId
          && canViewBookings()
          && request.resource.data.keys().hasOnly([
            'fcmTokens',
            'lastTokenUpdate'
          ])
        );

      allow delete: if isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == userId
          && canViewBookings()
        );
    }

    match /admins/{adminId} {
      allow read: if isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == adminId
        );

      allow create, update, delete: if isAdmin();
    }

    // =====================================================
    // TUTTE LE ALTRE RACCOLTE
    // =====================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
